# -*- mode: ruby -*-
# vi: set ft=ruby :
# To enable zsh, please set ENABLE_ZSH env var to "true" before launching vagrant up 
#   + On windows => $env:ENABLE_ZSH="true"
#   + On Linux  => export ENABLE_ZSH="true"

Vagrant.configure("2") do |config|
  config.vm.define "gitlab_ce" do |gitlab_ce|
    gitlab_ce.vm.box = "bento/ubuntu-24.04"
    gitlab_ce.vm.box_version = "202510.26.0"
    # gitlab_ce.vm.network "private_network", type: "dhcp"
    gitlab_ce.vm.network "private_network", type: "static", ip: "192.168.56.60"
    gitlab_ce.vm.hostname = "gitlab-ce"
    gitlab_ce.vm.provider "virtualbox" do |v|
      v.name = "gitlab-ce"
      v.memory = 8192
      v.cpus = 4
    end    
    gitlab_ce.vm.disk :disk, size: "100GB", primary: true
    gitlab_ce.vm.provision :shell do |shell|
      shell.path = "install_gitlab_ce.sh"
      shell.env = { 'ENABLE_ZSH' => ENV['ENABLE_ZSH'] }
    end
  end
end
