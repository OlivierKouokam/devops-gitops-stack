# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.define "jenkins-multinode" do |jenkins_multinode|
    jenkins_multinode.vm.box = "bento/ubuntu-24.04"
    jenkins_multinode.vm.box_version = "202510.26.0"
    jenkins_multinode.vm.network "private_network", type: "static", ip: "192.168.56.52"
    jenkins_multinode.vm.hostname = "jenkins-multinode"

    jenkins_multinode.vm.provider "virtualbox" do |v|
      v.name = "jenkins-multinode"
      v.memory = 8192
      v.cpus = 4
    end

    jenkins_multinode.vm.disk :disk, size: "100GB", primary: true

    jenkins_multinode.vm.provision :shell do |shell|
      shell.path = "install_jenkins_multinodes.sh"
    end
  end
end