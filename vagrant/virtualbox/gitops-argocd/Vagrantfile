# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

  # Nœud argocd_hub
  argocd_hub_ip = "192.168.60.80"
  config.vm.define "argocd-hub" do |argocd_hub|
    argocd_hub.vm.hostname = "argocd-hub"
    argocd_hub.vm.network "private_network", ip: argocd_hub_ip

    argocd_hub.vm.provider "virtualbox" do |vb|
      vb.name = "argocd-hub"
      vb.memory = "4096"
      vb.cpus = 2
      vb.customize ["guestproperty", "set", :id, "/VirtualBox/GuestAdd/VBoxService/--timesync-set-threshold", "1000"]
    end

    argocd_hub.vm.provision :shell do |shell|
      shell.path = "install_argocd_multi_node.sh"
      shell.args = ["argocd-hub", argocd_hub_ip]
    end
  end

  # Nœuds argocd-clusters
  argocd_clusters = 2
  ram_argocd_cluster = 2048
  cpu_argocd_cluster = 2
  
  (1..argocd_clusters).each do |i|
    argocd_cluster_ip = "192.168.60.#{80 + i}"
    config.vm.define "argocd-cluster#{i}" do |argocd_cluster|
      argocd_cluster.vm.network "private_network", type: "static", ip: argocd_cluster_ip
      argocd_cluster.vm.hostname = "argocd-cluster#{i}"
      
      argocd_cluster.vm.provider "virtualbox" do |v|
        v.name = "argocd-cluster#{i}"
        v.memory = ram_argocd_cluster
        v.cpus = cpu_argocd_cluster
        v.customize ["guestproperty", "set", :id, "/VirtualBox/GuestAdd/VBoxService/--timesync-set-threshold", "1000"]
      end
      
      argocd_cluster.vm.provision :shell do |shell|
        shell.path = "install_argocd_multi_node.sh"
        shell.args = ["argocd-cluster#{i}", argocd_cluster_ip]
      end
    end
  end  
end

